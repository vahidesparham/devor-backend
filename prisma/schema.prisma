  reasonCode        String                 @db.VarChar(80)
  description       String?                @db.VarChar(1000)
  status            ClassifiedReportStatus @default(OPEN)
  reviewedByAdminId Int?
  resolutionNote    String?                @db.VarChar(1000)
  reviewedAt        DateTime?
  version           Int                    @default(1)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  ad                ClassifiedAd           @relation(fields: [adId], references: [id], onDelete: Cascade)
  reporter          AppUser?               @relation(fields: [reporterAppUserId], references: [id], onDelete: SetNull)
  reviewedBy        AdminUser?             @relation("ClassifiedReportReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([adId, status, createdAt])
  @@index([reporterAppUserId, createdAt])
  @@index([reviewedByAdminId, status])
}

model ClassifiedAdStatusHistory {
  id         BigInt              @id @default(autoincrement())
  adId       Int
  fromStatus ClassifiedAdStatus?
  toStatus   ClassifiedAdStatus
  actorType  ClassifiedActorType
  actorId    String?             @db.VarChar(120)
  reasonCode String?             @db.VarChar(80)
  note       String?             @db.VarChar(1000)
  metadata   Json?
  createdAt  DateTime            @default(now())
  ad         ClassifiedAd        @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, createdAt])
  @@index([toStatus, createdAt])
  @@index([actorType, actorId])
}

model ClassifiedAdViewDaily {
  adId         Int
  viewDate     DateTime     @db.Date
  source       String       @default("unknown") @db.VarChar(40)
  viewCount    Int          @default(0)
  contactCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  ad           ClassifiedAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@id([adId, viewDate, source])
  @@index([viewDate, source])
}

model BusinessPermission {
  id              Int                      @id @default(autoincrement())
  key             String                   @unique @db.VarChar(160)
  groupName       String                   @db.VarChar(80)
  title           String                   @db.VarChar(160)
  description     String?                  @db.VarChar(255)
  displayOrder    Int                      @default(0)
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  rolePermissions BusinessRolePermission[]

  @@index([groupName, displayOrder])
  @@index([isActive, displayOrder])
}

model BusinessRole {
  id              Int                      @id @default(autoincrement())
  businessId      Int
  code            String                   @db.VarChar(120)
  title           String                   @db.VarChar(160)
  description     String?                  @db.VarChar(255)
  icon            String?                  @db.VarChar(120)
  color           String?                  @db.VarChar(30)
  isSystem        Boolean                  @default(false)
  isOwnerRole     Boolean                  @default(false)
  displayOrder    Int                      @default(0)
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  business        Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rolePermissions BusinessRolePermission[]
  memberships     BusinessMembership[]

  @@unique([businessId, code])
  @@index([businessId, isActive, displayOrder])
  @@index([businessId, isOwnerRole])
}

model BusinessRolePermission {
  roleId       Int
  permissionId Int
  role         BusinessRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   BusinessPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model BusinessMembership {
  id         Int          @id @default(autoincrement())
  businessId Int
  userId     Int
  roleId     Int
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       BusinessUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([businessId, roleId])
  @@index([userId, roleId])
  @@index([isActive])
}
