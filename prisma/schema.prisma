generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  BULK
  LOGIN
  LOGOUT
  REFRESH
}

enum TextDirection {
  LTR
  RTL
}

enum BannerPlacement {
  A
  B
  C
  D
  E
}

enum AttributeSelectionMode {
  SINGLE
  MULTIPLE
}

enum AttributeFieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum BusinessEconomicLevel {
  LOW
  MEDIUM
  HIGH
}

enum BusinessOperationMode {
  INFO_ONLY
  SHOWCASE
  ORDERING
  BOOKING
  ORDERING_AND_BOOKING
}

enum BusinessPublicationStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
}

enum BusinessContactLinkType {
  PHONE
  MOBILE
  WHATSAPP
  TELEGRAM
  INSTAGRAM
  WEBSITE
  EMAIL
  MAP
  CUSTOM
}

enum AppWalletTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
}

enum ClassifiedOwnerType {
  APP_USER
  BUSINESS
}

enum ClassifiedAdStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  PAUSED
  SOLD
  EXPIRED
  ARCHIVED
  SUSPENDED
}

enum ClassifiedPriceType {
  FIXED
  NEGOTIABLE
  FREE
  CONTACT
}

enum ClassifiedAttributeType {
  SELECT
  MULTI_SELECT
  TEXT
  NUMBER
  BOOLEAN
}

enum ClassifiedLocationPrecision {
  APPROXIMATE
  EXACT
}

enum ClassifiedReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ClassifiedActorType {
  APP_USER
  BUSINESS_USER
  ADMIN
  SYSTEM
}

enum WeekDay {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model AdminUser {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique @db.VarChar(191)
  firstName             String?                @db.VarChar(100)
  lastName              String?                @db.VarChar(100)
  avatar                String?                @db.VarChar(500)
  passwordHash          String                 @db.VarChar(255)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  adminUserRoles        AdminUserRole[]
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  errorLogs             ErrorLog[]
  appWalletTransactions AppWalletTransaction[]
  classifiedReports     ClassifiedReport[]     @relation("ClassifiedReportReviewer")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(191)
  title           String?          @db.VarChar(120)
  icon            String?          @db.VarChar(120)
  color           String?          @db.VarChar(30)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  adminUserRoles  AdminUserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique @db.VarChar(191)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model AdminUserRole {
  adminUserId Int
  roleId      Int
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id                  Int       @id @default(autoincrement())
  adminId             Int
  tokenHash           String    @unique @db.VarChar(191)
  expiresAt           DateTime?
  revokedAt           DateTime?
  revokedReason       String?   @db.VarChar(255)
  replacedByTokenHash String?   @db.VarChar(191)
  createdByIp         String?   @db.VarChar(100)
  userAgent           String?   @db.VarChar(255)
  createdAt           DateTime  @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model Language {
  id                                      Int                                      @id @default(autoincrement())
  code                                    String                                   @unique @db.VarChar(20)
  name                                    String                                   @db.VarChar(100)
  nativeName                              String?                                  @db.VarChar(100)
  image                                   String?                                  @db.VarChar(500)
  direction                               TextDirection                            @default(LTR)
  isActive                                Boolean                                  @default(true)
  isDefault                               Boolean                                  @default(false)
  createdAt                               DateTime                                 @default(now())
  updatedAt                               DateTime                                 @updatedAt
  slideshowTranslations                   SlideshowTranslation[]
  onboardingPageTranslations              OnboardingPageTranslation[]
  contentPageTranslations                 ContentPageTranslation[]
  blogPostTranslations                    BlogPostTranslation[]
  faqCategoryTranslations                 FaqCategoryTranslation[]
  faqTranslations                         FaqTranslation[]
  contactPageTranslations                 ContactPageTranslation[]
  bannerTranslations                      BannerTranslation[]
  businessTranslations                    BusinessTranslation[]
  serviceTypeTranslations                 ServiceTypeTranslation[]
  attributeGroupTranslations              AttributeGroupTranslation[]
  attributeOptionTranslations             AttributeOptionTranslation[]
  businessOfferingCategoryTranslations    BusinessOfferingCategoryTranslation[]
  businessOfferingTranslations            BusinessOfferingTranslation[]
  businessOfferingOptionGroupTranslations BusinessOfferingOptionGroupTranslation[]
  businessOfferingOptionTranslations      BusinessOfferingOptionTranslation[]
  countryTranslations                     CountryTranslation[]
  cityTranslations                        CityTranslation[]
  areaTranslations                        AreaTranslation[]

  @@index([isActive])
}

model ImageConfig {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(80)
  width           Int
  height          Int
  thumbnailWidth  Int
  thumbnailHeight Int
  folderName      String   @db.VarChar(120)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PanelSetting {
  id           Int      @id
  panelTitle   String   @default("Devor") @db.VarChar(120)
  panelLogo    String?  @db.VarChar(500)
  panelFavicon String?  @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        BigInt      @id @default(autoincrement())
  createdAt DateTime    @default(now())
  traceId   String?     @db.VarChar(100)
  adminId   Int?
  action    AuditAction
  entity    String      @db.VarChar(120)
  entityId  String?     @db.VarChar(120)
  method    String      @db.VarChar(10)
  path      String      @db.VarChar(255)
  ip        String?     @db.VarChar(100)
  userAgent String?     @db.VarChar(255)
  before    Json?
  after     Json?
  details   Json?

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([traceId])
  @@index([entity, entityId])
}

model ErrorLog {
  id         BigInt   @id @default(autoincrement())
  createdAt  DateTime @default(now())
  traceId    String?  @db.VarChar(100)
  adminId    Int?
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(255)
  query      Json?
  ip         String?  @db.VarChar(100)
  userAgent  String?  @db.VarChar(255)
  statusCode Int
  code       String   @db.VarChar(120)
  message    String   @db.VarChar(500)
  stack      String?  @db.Text
  details    Json?
  durationMs Float?

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([traceId])
  @@index([statusCode, code])
}

model Slideshow {
  id           Int                    @id @default(autoincrement())
  fromDate     DateTime?
  toDate       DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  translations SlideshowTranslation[]

  @@index([fromDate])
  @@index([toDate])
  @@index([createdAt])
}

model SlideshowTranslation {
  id          Int      @id @default(autoincrement())
  slideshowId Int
  lang        String   @db.VarChar(20)
  title       String   @db.VarChar(255)
  link        String?  @db.VarChar(500)
  image       String   @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slideshow Slideshow @relation(fields: [slideshowId], references: [id], onDelete: Cascade)
  language  Language  @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([slideshowId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
  @@index([slideshowId])
}

model OnboardingPage {
  id           Int                         @id @default(autoincrement())
  image        String                      @db.VarChar(500)
  color        String?                     @db.VarChar(30)
  displayOrder Int                         @default(0)
  isActive     Boolean                     @default(true)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  translations OnboardingPageTranslation[]

  @@index([isActive, displayOrder])
  @@index([createdAt])
}

model OnboardingPageTranslation {
  id               Int      @id @default(autoincrement())
  onboardingPageId Int
  lang             String   @db.VarChar(20)
  title            String   @db.VarChar(255)
  description      String?  @db.Text
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  onboardingPage OnboardingPage @relation(fields: [onboardingPageId], references: [id], onDelete: Cascade)
  language       Language       @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([onboardingPageId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
  @@index([onboardingPageId])
}

model ContentPage {
  id           Int                      @id @default(autoincrement())
  slug         String                   @unique @db.VarChar(160)
  image        String?                  @db.VarChar(500)
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  translations ContentPageTranslation[]

  @@index([isActive])
  @@index([createdAt])
}

model ContentPageTranslation {
  id            Int      @id @default(autoincrement())
  contentPageId Int
  lang          String   @db.VarChar(20)
  title         String   @db.VarChar(255)
  body          String   @db.LongText
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentPage ContentPage @relation(fields: [contentPageId], references: [id], onDelete: Cascade)
  language    Language    @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([contentPageId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
  @@index([contentPageId])
}

model BlogPost {
  id             Int                   @id @default(autoincrement())
  image          String?               @db.VarChar(500)
  readingMinutes Int?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  translations   BlogPostTranslation[]

  @@index([isActive])
  @@index([createdAt])
}

model BlogPostTranslation {
  id               Int      @id @default(autoincrement())
  blogPostId       Int
  lang             String   @db.VarChar(20)
  title            String   @db.VarChar(255)
  shortDescription String?  @db.VarChar(500)
  body             String   @db.LongText
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([blogPostId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
  @@index([blogPostId])
}

model FaqCategory {
  id           Int                      @id @default(autoincrement())
  image        String?                  @db.VarChar(500)
  displayOrder Int                      @default(0)
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  translations FaqCategoryTranslation[]
  faqs         Faq[]

  @@index([isActive, displayOrder])
  @@index([createdAt])
}

model FaqCategoryTranslation {
  id            Int      @id @default(autoincrement())
  faqCategoryId Int
  lang          String   @db.VarChar(20)
  title         String   @db.VarChar(255)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  faqCategory FaqCategory @relation(fields: [faqCategoryId], references: [id], onDelete: Cascade)
  language    Language    @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([faqCategoryId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
  @@index([faqCategoryId])
}

model Faq {
  id           Int              @id @default(autoincrement())
  categoryId   Int
  displayOrder Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  category     FaqCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations FaqTranslation[]

  @@index([categoryId, isActive, displayOrder])
  @@index([createdAt])
}

model FaqTranslation {
  id        Int      @id @default(autoincrement())
  faqId     Int
  lang      String   @db.VarChar(20)
  question  String   @db.VarChar(500)
  answer    String   @db.LongText
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faq      Faq      @relation(fields: [faqId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([faqId, lang])
  @@index([lang, question])
  @@index([lang, isActive])
  @@index([faqId])
}

model ContactPage {
  id                 Int                      @id
  instagram          String?                  @db.VarChar(500)
  telegram           String?                  @db.VarChar(500)
  whatsapp           String?                  @db.VarChar(500)
  youtube            String?                  @db.VarChar(500)
  tiktok             String?                  @db.VarChar(500)
  email              String?                  @db.VarChar(191)
  supportPhoneNumber String?                  @db.VarChar(80)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  translations       ContactPageTranslation[]
}

model ContactPageTranslation {
  id            Int      @id @default(autoincrement())
  contactPageId Int
  lang          String   @db.VarChar(20)
  title         String   @db.VarChar(255)
  body          String   @db.LongText
  phoneNumber   String?  @db.VarChar(80)
  address       String?  @db.Text
  workingHours  String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contactPage ContactPage @relation(fields: [contactPageId], references: [id], onDelete: Cascade)
  language    Language    @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([contactPageId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
  @@index([contactPageId])
}

model Banner {
  id           Int                 @id @default(autoincrement())
  placement    BannerPlacement
  fromDate     DateTime?
  toDate       DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  translations BannerTranslation[]

  @@index([placement])
  @@index([fromDate])
  @@index([toDate])
  @@index([createdAt])
}

model BannerTranslation {
  id        Int      @id @default(autoincrement())
  bannerId  Int
  lang      String   @db.VarChar(20)
  title     String   @db.VarChar(255)
  link      String?  @db.VarChar(500)
  image     String   @db.VarChar(500)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  banner   Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([bannerId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
  @@index([bannerId])
}

model ServiceType {
  id              Int                      @id @default(autoincrement())
  parentId        Int?
  code            String                   @unique @db.VarChar(80)
  title           String                   @db.VarChar(160)
  image           String?                  @db.VarChar(500)
  pinIconImage    String?                  @db.VarChar(500)
  color           String?                  @db.VarChar(30)
  description     String?                  @db.VarChar(500)
  displayOrder    Int                      @default(0)
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  parent          ServiceType?             @relation("ServiceTypeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        ServiceType[]            @relation("ServiceTypeHierarchy")
  translations    ServiceTypeTranslation[]
  attributeGroups AttributeGroup[]
  businesses      Business[]

  @@index([isActive, displayOrder])
  @@index([parentId, isActive, displayOrder])
}

model ServiceTypeTranslation {
  id            Int         @id @default(autoincrement())
  serviceTypeId Int
  lang          String      @db.VarChar(20)
  title         String      @db.VarChar(160)
  description   String?     @db.VarChar(500)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  language      Language    @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([serviceTypeId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
}

model AttributeGroup {
  id            Int                         @id @default(autoincrement())
  serviceTypeId Int
  code          String                      @db.VarChar(120)
  title         String                      @db.VarChar(160)
  image         String?                     @db.VarChar(500)
  fieldType     AttributeFieldType          @default(MULTI_SELECT)
  selectionMode AttributeSelectionMode      @default(MULTIPLE)
  unit          String?                     @db.VarChar(60)
  isRequired    Boolean                     @default(false)
  showInFilters Boolean                     @default(false)
  displayOrder  Int                         @default(0)
  isActive      Boolean                     @default(true)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  serviceType   ServiceType                 @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  translations  AttributeGroupTranslation[]
  options       AttributeOption[]
  values        BusinessAttributeValue[]

  @@unique([serviceTypeId, code])
  @@index([serviceTypeId, isActive, displayOrder])
  @@index([serviceTypeId, showInFilters, isActive, displayOrder], map: "AttrGroup_filter_idx")
}

model AttributeGroupTranslation {
  id        Int            @id @default(autoincrement())
  groupId   Int
  lang      String         @db.VarChar(20)
  title     String         @db.VarChar(160)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  group     AttributeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  language  Language       @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([groupId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
}

model AttributeOption {
  id                 Int                          @id @default(autoincrement())
  groupId            Int
  key                String                       @db.VarChar(120)
  title              String                       @db.VarChar(160)
  image              String?                      @db.VarChar(500)
  color              String?                      @db.VarChar(30)
  displayOrder       Int                          @default(0)
  isActive           Boolean                      @default(true)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  group              AttributeGroup               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  translations       AttributeOptionTranslation[]
  businessAttributes BusinessAttribute[]

  @@unique([groupId, key])
  @@index([groupId, isActive, displayOrder])
}

model AttributeOptionTranslation {
  id        Int             @id @default(autoincrement())
  optionId  Int
  lang      String          @db.VarChar(20)
  title     String          @db.VarChar(160)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  option    AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  language  Language        @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([optionId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
}

model Country {
  id            Int                  @id @default(autoincrement())
  code          String               @unique @db.VarChar(10)
  title         String               @db.VarChar(160)
  phoneCode     String               @db.VarChar(20)
  flagImage     String?              @db.VarChar(500)
  displayOrder  Int                  @default(0)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  translations  CountryTranslation[]
  cities        City[]
  businesses    Business[]
  classifiedAds ClassifiedAd[]

  @@index([isActive, displayOrder])
}

model CountryTranslation {
  id        Int      @id @default(autoincrement())
  countryId Int
  lang      String   @db.VarChar(20)
  title     String   @db.VarChar(160)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  language  Language @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([countryId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
}

model City {
  id            Int               @id @default(autoincrement())
  countryId     Int
  code          String            @db.VarChar(120)
  title         String            @db.VarChar(160)
  latitude      Decimal?          @db.Decimal(10, 7)
  longitude     Decimal?          @db.Decimal(10, 7)
  displayOrder  Int               @default(0)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  country       Country           @relation(fields: [countryId], references: [id], onDelete: Cascade)
  translations  CityTranslation[]
  areas         Area[]
  businesses    Business[]
  classifiedAds ClassifiedAd[]

  @@unique([countryId, code])
  @@index([countryId, isActive, displayOrder])
}

model CityTranslation {
  id        Int      @id @default(autoincrement())
  cityId    Int
  lang      String   @db.VarChar(20)
  title     String   @db.VarChar(160)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  language  Language @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cityId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
}

model Area {
  id            Int               @id @default(autoincrement())
  cityId        Int
  code          String            @db.VarChar(120)
  title         String            @db.VarChar(160)
  displayOrder  Int               @default(0)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  city          City              @relation(fields: [cityId], references: [id], onDelete: Cascade)
  translations  AreaTranslation[]
  businesses    Business[]
  classifiedAds ClassifiedAd[]

  @@unique([cityId, code])
  @@index([cityId, isActive, displayOrder])
}

model AreaTranslation {
  id        Int      @id @default(autoincrement())
  areaId    Int
  lang      String   @db.VarChar(20)
  title     String   @db.VarChar(160)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  language  Language @relation(fields: [lang], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([areaId, lang])
  @@index([lang, title])
  @@index([lang, isActive])
}

model Business {
  id                  Int                        @id @default(autoincrement())
  serviceTypeId       Int
  countryId           Int?
  cityId              Int?
  areaId              Int?
